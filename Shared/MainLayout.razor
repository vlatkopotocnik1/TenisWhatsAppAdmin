@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>WhatsAppAdmin</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <a href="" @onclick="Logout">Logout</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login">Login</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/notyf/notyf.min.css">
<script src="https://cdn.jsdelivr.net/npm/notyf/notyf.min.js"></script>
<script>

    window.showCustomContextMenu = function (event) {
        event.preventDefault(); // block browser menu only on right-click targets
    };

    window.showToast = function (msg, type) {
      const notyf = new Notyf({ duration: 2500, position: { x: 'right', y: 'bottom' } });
      if (type === 'error') notyf.error(msg);
      else notyf.success(msg);
    };
</script>

@code {
    private async Task Logout()
    {
        if (AuthStateProvider is WhatsAppAdmin.Authentication.AuthStateProvider Auth)
        {
            await Auth.LogoutAsync();
        }

        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
