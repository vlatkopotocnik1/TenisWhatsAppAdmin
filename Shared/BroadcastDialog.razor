@using MudBlazor
@using WhatsAppAdmin.Services
@inject ISnackbar Snackbar
@inject OverlayService OverlayService
@inject WhapiService WhapiService

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_message" Label="Message" Lines="4" FullWidth="true" Variant="Variant.Outlined" />
    </DialogContent>

    <DialogActions>
        <MudStack Row Justify="Justify.FlexEnd" Spacing="2">
            <MudButton OnClick="Cancel">Cancel</MudButton>
            <MudButton Color="Color.Primary" OnClick="Send">Send</MudButton>
        </MudStack>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }
    [Parameter] public string? Id { get; set; }
    [Parameter] public bool ToAllGroups { get; set; }

    private string _message = "";

    private async Task Send()
    {
        if (string.IsNullOrWhiteSpace(_message))
        {
            Snackbar.Add("Message cannot be empty", Severity.Warning);
            return;
        }

        await OverlayService.RunAsync(async () =>
        {
            try
            {
                if (ToAllGroups)
                {
                    var groups = await WhapiService.GetAllGroupsAsync();
                    foreach (var g in groups)
                    {
                        var id = g.GetProperty("id").GetString();
                        try
                        {
                            await WhapiService.SendMessageToGroupAsync(id!, _message);
                            Snackbar.Add($"Message sent successfully to {id}", Severity.Success);
                        }
                        catch (Exception ex)
                        {
                            Snackbar.Add($"Failed to send to {id}: {ex.Message}", Severity.Error);
                        }
                    }
                }
                else if (Id is not null)
                {
                    try
                    {
                        await WhapiService.SendMessageToGroupAsync(Id!, _message);
                        Snackbar.Add($"Message sent successfully to {Id}", Severity.Success);
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add($"Failed to send to {Id}: {ex.Message}", Severity.Error);
                    }
                }
                MudDialog.Close(DialogResult.Ok(true));
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Failed to send message: {ex.Message}", Severity.Error, config =>
                    {
                        config.RequireInteraction = true;
                        config.ShowCloseIcon = true;
                    });
            }
        }, "Sending broadcast...");
    }

    private void Cancel() => MudDialog.Cancel();
}
