@inherits ComponentBase

@if (Visible)
{
    <div class="modal-backdrop" @onclick="Close" style="position:fixed; inset:0; background:rgba(0,0,0,0.35); z-index:10000;">
        <div class="app-modal" style="position:fixed; left:50%; top:50%; transform:translate(-50%,-50%); background:#fff; padding:18px; border-radius:8px; box-shadow:0 6px 24px rgba(0,0,0,0.25); z-index:10001;"
             @onclick:stopPropagation
             @oncontextmenu:preventDefault
             @oncontextmenu:stopPropagation>
            <div style="font-weight:700; margin-bottom:8px;">@Title</div>

            @if (Fields?.Count > 0)
            {
                <div style="margin-bottom:12px;">
                    @foreach (var field in Fields)
                    {
                        <div style="margin-bottom:8px;">
                            @if (field.Type == "text")
                            {
                                <input class="form-control"
                                       placeholder="@field.Placeholder"
                                       style="width:360px; max-width:80vw; padding:8px; border-radius:6px; border:1px solid #ddd;"
                                       @bind="@field.Value"
                                       @bind:event="oninput" />
                            }
                            else if (field.Type == "textarea")
                            {
                                <textarea class="form-control"
                                          placeholder="@field.Placeholder"
                                          style="width:360px; max-width:80vw; padding:8px; border-radius:6px; border:1px solid #ddd;"
                                          @bind="@field.Value"></textarea>
                            }
                            else if (field.Type == "number")
                            {
                                <input type="number"
                                       class="form-control"
                                       placeholder="@field.Placeholder"
                                       style="width:360px; max-width:80vw; padding:8px; border-radius:6px; border:1px solid #ddd;"
                                       @bind="@field.Value"
                                       @bind:event="oninput" />
                            }
                        </div>
                    }
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(BodyText))
            {
                <div style="margin-bottom:16px;">@((MarkupString)BodyText)</div>
            }

            <div style="display:flex; justify-content:flex-end; gap:8px;">
                @if (Buttons?.Count > 0)
                {
                    @foreach (var btn in Buttons)
                    {
                        <button class="@btn.CssClass" @onclick="() => ButtonClicked(btn)">
                            @btn.Text
                        </button>
                    }
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }

    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? BodyText { get; set; }

    [Parameter] public List<GenericField>? Fields { get; set; }
    [Parameter] public List<GenericButton>? Buttons { get; set; }

    private async Task ButtonClicked(GenericButton btn)
    {
        if (btn.CloseOnClick)
        {
            Visible = false;
            await VisibleChanged.InvokeAsync(false);
        }

        if (btn.OnClick.HasDelegate)
        {
            _ = InvokeAsync(async () =>
            {
                try
                {
                    await btn.OnClick.InvokeAsync(Fields);
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Button action failed: {ex.Message}");
                }
            });
        }
    }


    private async Task Close()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }
}

@code {
    public class GenericField
    {
        public string Name { get; set; } = string.Empty;
        public string Type { get; set; } = "text";
        public string Placeholder { get; set; } = string.Empty;
        public string? Value { get; set; }
    }

    public class GenericButton
    {
        public string Text { get; set; } = "OK";
        public string CssClass { get; set; } = "btn btn-primary";
        public EventCallback<List<GenericField>?> OnClick { get; set; }
        public bool CloseOnClick { get; set; } = true;
    }
}
