@page "/"
@using System.Text.Json
@using WhatsAppAdmin.Models
@using WhatsAppAdmin.Services
@inject ImportStateService ImportState
@inject IService Service
@inject IJSRuntime JS
@inject WhatsAppAdmin.Services.WhapiService WhapiService
@attribute [Authorize]
<PageTitle>Index</PageTitle>

<ImportToolbar />

@if (_loading)
{
	<div style="padding:20px;">Loading…</div>
}
else
{
	<div class="whatsAppGroups-board">
		@foreach (var whatsAppGroup in _whatsAppGroups)
		{
			<div class="whatsAppGroup-column">
				<div class="whatsAppGroup-header" data-status="@GetGroupStatus(whatsAppGroup)">
					<div class="group-header-left" title="@whatsAppGroup.Name">
						@whatsAppGroup.Name
					</div>

					<div class="group-header-right">
						@if (whatsAppGroup.IsNew)
						{
							<div class="group-status-badge group-status-new">🆕 Will be created</div>
						}
						else if (whatsAppGroup.ToAdd.Any() || whatsAppGroup.ToRemove.Any())
						{
							<div class="group-status-badge group-status-changed">⚙️ Has member changes</div>
						}
						else
						{
							<div class="group-status-badge group-status-unchanged">✅ No changes</div>
						}
						<button class="btn-delete"
								title="Delete group"
								@onclick="() => DeleteGroup(whatsAppGroup.Name)"
								disabled="@(_deletingGroupName == whatsAppGroup.Name)">
							@if (_deletingGroupName == whatsAppGroup.Name)
							{
								<span>⟳</span>
							}
							else
							{
								<span>🗑️</span>
							}
						</button>
					</div>
				</div>

				<div class="whatsAppGroup-body">
					@if (whatsAppGroup.Users.Count == 0 && !whatsAppGroup.ToAdd.Any())
					{
						<div class="empty-group">No users yet.</div>
					}

					@foreach (var user in whatsAppGroup.Users)
					{
						var isRemove = whatsAppGroup.ToRemove.Any(u => NormalizePhone(u.PhoneNumber) == NormalizePhone(user.PhoneNumber));
						var css = isRemove ? "user-remove" : "user-row";

						<div class="whatsAppGroup-grid @css" draggable="true" tabindex="0">
							<div class="user-main">
								@user.Name
								@if (isRemove)
								{
									<span class="user-status user-status-remove">(Will be removed)</span>
								}
							</div>
							<div class="user-details">
								<div><strong>Phone:</strong> @user.PhoneNumber</div>
							</div>
						</div>
					}

					@foreach (var user in whatsAppGroup.ToAdd)
					{
						<div class="whatsAppGroup-grid user-add-preview">
							<div class="user-main">
								@user.Name <span class="user-status user-status-add">(Will be added)</span>
							</div>
							<div class="user-details">
								<div><strong>Phone:</strong> @user.PhoneNumber</div>
							</div>
						</div>
					}
				</div>
			</div>
		}
	</div>

	@if (_whatsAppGroups.Count != 0)
	{
		<button class="btn-import btn-import-green"
				@onclick="SyncGroupsOnWhatsApp"
				disabled="@_isCreating">
			<span class="btn-icon">🔄</span>
			@(_isCreating ? "Syncing Groups…" : "Sync WhatsApp Groups")
		</button>
		<button class="btn-import btn-import-red"
				@onclick="DeleteAllGroupsFromWhatsApp"
				disabled="@_isDeleting">
			<span class="btn-icon">🗑️</span>
			@(_isDeleting ? "Deleting Groups…" : "Delete All WhatsApp Groups")
		</button>
		@if (!string.IsNullOrEmpty(_statusMessage))
		{
			<div class="import-status">@_statusMessage</div>
		}
	}
}
