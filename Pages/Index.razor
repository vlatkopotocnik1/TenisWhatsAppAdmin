@page "/"
@using TenisWhatsAppAdmin.Models
@inject IJSRuntime JS
@attribute [Authorize]
<PageTitle>Index</PageTitle>

@inject TenisWhatsAppAdmin.Services.ILeagueService LeagueService
<div class="leagues-board">
    @foreach (var league in _leagues)
    {
        <div class="league-column"
             ondragover="event.preventDefault()"
             @ondrop="e => OnDrop(e, league.Id)"
             @ondragover:preventDefault>

            <div class="league-header" data-color="@GetLeagueColor(league.Name)">
                @league.Name
            </div>

            <div class="league-body">
                <div class="league-grid league-grid-header">
                    <div>Player</div>
                    <div>Played</div>
                    <div>Won</div>
                    <div>Lost</div>
                    <div>For</div>
                </div>

                @foreach (var player in league.Players)
                {
                    <div class="league-grid player-row"
                         draggable="true"
                         @ondragstart="e => OnDragStart(e, player.Id, league.Id)">
                        <div>@player.Name</div>
                        <div>@player.Played</div>
                        <div>@player.Won</div>
                        <div>@player.Lost</div>
                        <div>@player.Rating</div>
                    </div>
                }
            </div>
        </div>
    }
</div>



<script>
	window.dragHelper = {
		setDragData: function (e, data) {
			e.dataTransfer.setData("text/plain", data);
		}
	};
</script>

@code {
    private List<League> _leagues = new();
    private bool _loading = true;

    // temp drag info
    private Guid _draggingPlayerId;
    private string? _dragFromLeagueId;

    protected override async Task OnInitializedAsync()
    {
        _leagues = await LeagueService.GetLeaguesAsync();
        _loading = false;
    }

    private void OnDragStart(DragEventArgs e, Guid playerId, string fromLeagueId)
    {
        // store the drag info server-side (no call to DataTransfer.SetData)
        _draggingPlayerId = playerId;
        _dragFromLeagueId = fromLeagueId;

        // optionally set the allowed effect, this doesn't call setData:
        if (e.DataTransfer != null)
        {
            e.DataTransfer.DropEffect = "move";
        }
        // No DataTransfer.SetData call here — that caused the exception.
    }

    private async Task OnDrop(DragEventArgs e, string toLeagueId)
    {
        if (_draggingPlayerId == Guid.Empty || string.IsNullOrEmpty(_dragFromLeagueId)) return;
        if (_dragFromLeagueId == toLeagueId) return; // no-op

        _loading = true;
        StateHasChanged();

        // call service to move
        _leagues = await LeagueService.MovePlayerAsync(_draggingPlayerId, _dragFromLeagueId, toLeagueId);

        // reset
        _draggingPlayerId = Guid.Empty;
        _dragFromLeagueId = null;
        _loading = false;
        StateHasChanged();
    }

    private string GetLeagueColor(string name) => name switch
    {
        var n when n.Contains("1") => "blue",
        var n when n.Contains("2") => "red",
        var n when n.Contains("3") => "purple",
        _ => "orange"
    };
}

