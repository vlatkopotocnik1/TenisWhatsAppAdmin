@page "/"
@using MudBlazor
@using WhatsAppAdmin.Models
@using WhatsAppAdmin.Services
@inject IDialogService DialogService

@attribute [Authorize]
<PageTitle>Index</PageTitle>


<MudPaper Class="actions-bar d-flex align-center justify-space-between mb-3 p-2" Elevation="1">

	<MudMenu Class="actions-menu">
		<ActivatorContent>
			<MudButton Variant="Variant.Outlined"
					   Color="Color.Primary"
					   StartIcon="@Icons.Material.Filled.Menu"
					   Class="action-button">
				Admin Actions
			</MudButton>
		</ActivatorContent>

		<ChildContent>
			<MudMenuItem OnClick="@SyncGroupsOnWhatsApp">
				<MudIcon Icon="@Icons.Material.Filled.Refresh" Class="mr-2" /> Sync WhatsApp
			</MudMenuItem>
			<MudDivider />
			<MudMenuItem OnClick="@DeleteAllGroupsFromWhatsApp">
				<MudIcon Icon="@Icons.Material.Filled.DeleteForever" Class="mr-2" /> Delete All Groups
			</MudMenuItem>
		</ChildContent>
	</MudMenu>

	<Toolbar />

	<MudButton Variant="Variant.Outlined"
			   Color="Color.Secondary"
			   StartIcon="@Icons.Material.Filled.Campaign"
			   OnClick="() => OpenBroadcastDialog()"
			   Class="action-button action-button-broadcast">
		Broadcast
	</MudButton>

</MudPaper>

<div class="whatsAppGroups-board">
	@foreach (var g in _whatsAppGroups)
	{
		<div class="whatsAppGroup-column">
			<div class="whatsAppGroup-header" data-status="@GetGroupStatus(g)">
				<div class="group-header-left">@g.Name</div>
				<div class="group-header-right">
					<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="0">
						@if (g.IsNew)
						{
							<MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.NewReleases">
								Will be created
							</MudChip>
						}
						else if (g.ToAdd.Any() || g.ToRemove.Any())
						{
							<MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Build">
								Has member changes
							</MudChip>
						}
						else
						{
							<MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CheckCircle">
								No changes
							</MudChip>
						}

						<MudMenu Size="Size.Small" Class="menu-ellipsis modern-menu" Icon="@Icons.Material.Filled.MoreHoriz" Color="Color.Default" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
							<MudMenuItem OnClick="() => OpenAddUserDialog(g.Name, g.IsNew)">
								<MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" Class="mr-2" /> Add User
							</MudMenuItem>
							<MudMenuItem OnClick="() => OpenBroadcastDialog(g.Id, g.Name)">
								<MudIcon Icon="@Icons.Material.Filled.Campaign" Color="Color.Info" Class="mr-2" /> Send Message to Group
							</MudMenuItem>
							<MudMenuItem OnClick="() => OpenRenameGroupDialog(g.Id, g.Name, g.IsNew)">
								<MudIcon Icon="@Icons.Material.Filled.Edit" Color="Color.Secondary" Class="mr-2" /> Rename Group
							</MudMenuItem>
							<MudMenuItem OnClick="() => OpenDeleteGroupDialog(g.Id, g.Name, g.IsNew)" Color="Color.Error">
								<MudIcon Icon="@Icons.Material.Filled.DeleteForever" Color="Color.Error" Class="mr-2" /> Delete All Users
							</MudMenuItem>
						</MudMenu>
					</MudStack>
				</div>
			</div>

			<div class="whatsAppGroup-body">
				@if (!g.Users.Any() && !g.ToAdd.Any())
				{
					<div class="empty-group">No users yet.</div>
				}

				@foreach (var u in g.Users)
				{
					var isRemove = g.ToRemove.Any(r => MainLayout.NormalizePhone(r.PhoneNumber) == MainLayout.NormalizePhone(u.PhoneNumber));
					<div class="whatsAppGroup-grid @(isRemove ? "user-row user-remove" : "user-row")">
						<div class="user-main">
							@u.Name @u.PhoneNumber
							@if (u.Rank == "admin" || u.Rank == "creator")
							{
								<span> (@(string.IsNullOrEmpty(u.Rank) ? "" : char.ToUpper(u.Rank[0]) + u.Rank.Substring(1).ToLower())) </span>
							}
							@if (isRemove)
							{
								<span class="user-status user-status-remove">(Will be removed)</span>
							}
						</div>
						@if (u.Rank != "creator")
						{
							<MudMenu Size="Size.Small" Class="menu-ellipsis modern-menu" Icon="@Icons.Material.Filled.MoreHoriz" Color="Color.Default" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
								<MudMenuItem OnClick="() => OpenBroadcastDialog(u.PhoneNumber, string.IsNullOrEmpty(u.Name) ? u.PhoneNumber : u.Name)">
									<MudIcon Icon="@Icons.Material.Filled.Campaign" Color="Color.Info" Class="mr-2" />
									Send message to user
								</MudMenuItem>

								<MudMenuItem OnClick="() => OpenDeleteUserDialog(u.PhoneNumber, g.Id, g.Name, g.IsNew)" Color="Color.Error">
									<MudIcon Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Class="mr-2" />
									Delete user
								</MudMenuItem>
							</MudMenu>
						}
					</div>
				}

				@foreach (var u in g.ToAdd)
				{
					<div class="whatsAppGroup-grid user-add-preview user-row">
						<div class="user-main">@u.PhoneNumber <span class="user-status user-status-add">(Will be added)</span></div>
					</div>
				}
			</div>
		</div>
	}
</div>
