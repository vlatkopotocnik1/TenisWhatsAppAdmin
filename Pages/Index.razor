@page "/"
@using MudBlazor
@using WhatsAppAdmin.Models
@using WhatsAppAdmin.Services
@inject IDialogService DialogService

@attribute [Authorize]
<PageTitle>Index</PageTitle>

<Toolbar />

@if (_whatsAppGroups.Count != 0)
{
	<div style="margin-bottom:10px;">
		<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SyncGroupsOnWhatsApp">
			<MudIcon Icon="@Icons.Material.Filled.Sync" Class="me-2" />
			Sync WhatsApp Groups
		</MudButton>

		<MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="DeleteAllGroupsFromWhatsApp">
			<MudIcon Icon="@Icons.Material.Filled.DeleteForever" Class="me-2" />
			Delete All WhatsApp Groups
		</MudButton>

		<MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="OpenBroadcastAllDialog">
			<MudIcon Icon="@Icons.Material.Filled.Campaign" Class="me-2" />
			Broadcast to All Groups
		</MudButton>
	</div>
}

<div class="whatsAppGroups-board">
	@foreach (var g in _whatsAppGroups)
	{
		<div class="whatsAppGroup-column">
			<div class="whatsAppGroup-header @( _contextGroupName == g.Name && _contextMenuVisible ? "menu-active" : "" )" data-status="@GetGroupStatus(g)">
				<div class="group-header-left">@g.Name</div>
				<div class="group-header-right">
					<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Spacing="0">
						@if (g.IsNew)
						{
							<MudChip T="string" Color="Color.Info" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.NewReleases">
								Will be created
							</MudChip>
						}
						else if (g.ToAdd.Any() || g.ToRemove.Any())
						{
							<MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Build">
								Has member changes
							</MudChip>
						}
						else
						{
							<MudChip T="string" Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.CheckCircle">
								No changes
							</MudChip>
						}

						<MudMenu Size="Size.Small" Class="menu-ellipsis" Icon="@Icons.Material.Filled.MoreHoriz" Color="Color.Default" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopRight">
							<MudMenuItem OnClick="() => ConfirmAddUser(g.Name)">
								<MudIcon Icon="@Icons.Material.Filled.PersonAdd" Class="mr-2" /> Add User
							</MudMenuItem>
							<MudMenuItem OnClick="() => ConfirmRenameGroup(g.Name)">
								<MudIcon Icon="@Icons.Material.Filled.Edit" Class="mr-2" /> Rename Group
							</MudMenuItem>
							<MudMenuItem OnClick="() => ConfirmDeleteAllUsersFromGroup(g.Name)" Color="Color.Error">
								<MudIcon Icon="@Icons.Material.Filled.DeleteForever" Class="mr-2" /> Delete All Users
							</MudMenuItem>
						</MudMenu>
					</MudStack>
				</div>
			</div>

			<div class="whatsAppGroup-body">
				@if (!g.Users.Any() && !g.ToAdd.Any())
				{
					<div class="empty-group">No users yet.</div>
				}

				@foreach (var u in g.Users)
				{
					var isRemove = g.ToRemove.Any(r => NormalizePhone(r.PhoneNumber) == NormalizePhone(u.PhoneNumber));
					<div class="whatsAppGroup-grid @(isRemove ? "user-row user-remove" : "user-row")">
						<div class="user-main">
							@u.PhoneNumber
							@if (u.Rank == "admin" || u.Rank == "creator")
							{
								<span> (@(string.IsNullOrEmpty(u.Rank) ? "" : char.ToUpper(u.Rank[0]) + u.Rank.Substring(1).ToLower())) </span>
							}
							@if (isRemove)
							{
								<span class="user-status user-status-remove">(Will be removed)</span>
							}
						</div>
						@if (u.Rank != "creator")
						{
							<MudMenu Size="Size.Small" Class="menu-ellipsis" Icon="@Icons.Material.Filled.MoreHoriz" Color="Color.Default" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.TopRight">
								<MudMenuItem OnClick="() => ConfirmDeleteUser(u.PhoneNumber, g.Name)">
									<MudIcon Icon="@Icons.Material.Filled.Delete" Class="mr-2" /> Delete User
								</MudMenuItem>
							</MudMenu>
						}
					</div>
				}

				@foreach (var u in g.ToAdd)
				{
					<div class="whatsAppGroup-grid user-add-preview user-row">
						<div class="user-main">@u.PhoneNumber <span class="user-status user-status-add">(Will be added)</span></div>
					</div>
				}
			</div>
		</div>
	}
</div>

<PromptDialog Visible="@_modalVisible"
			  VisibleChanged="@((bool v) => _modalVisible = v)"
			  Title="@_modalTitle"
			  BodyText="@_modalBodyText"
			  Fields="@_modalFields"
			  Buttons="@_modalButtons" />
