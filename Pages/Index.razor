@page "/"
@using WhatsAppAdmin.Models
@using WhatsAppAdmin.Services

@attribute [Authorize]
<PageTitle>Index</PageTitle>

@if (_loading)
{
	<div style="padding:20px;">Loading…</div>
}
else
{
	<div style="margin-bottom:10px;">
		<button class="btn-import btn-import-blue" @onclick="SyncGroupsOnWhatsApp" disabled="@_isCreating">
			<span class="btn-icon">🔄</span>
			@(_isCreating ? "Syncing Groups…" : "Sync WhatsApp Groups")
		</button>
		<button class="btn-import btn-import-red" @onclick="DeleteAllGroupsFromWhatsApp" disabled="@_isDeleting">
			<span class="btn-icon">🗑️</span>
			@(_isDeleting ? "Deleting Groups…" : "Delete All WhatsApp Groups")
		</button>
	</div>

	<div class="whatsAppGroups-board">
		@foreach (var g in _whatsAppGroups)
		{
			<div class="whatsAppGroup-column">
				<div class="whatsAppGroup-header" data-status="@GetGroupStatus(g)">
					<div class="group-header-left">@g.Name</div>
					<div class="group-header-right">
						@if (g.IsNew)
						{
							<div class="group-status-badge group-status-new">🆕 Will be created</div>
						}
						else if (g.ToAdd.Any() || g.ToRemove.Any())
						{
							<div class="group-status-badge group-status-changed">⚙️ Has member changes</div>
						}
						else
						{
							<div class="group-status-badge group-status-unchanged">✅ No changes</div>
						}

						<div class="menu-ellipsis"
							 @onclick="e => ToggleGroupMenu(e, g.Name)" @onclick:stopPropagation>
							⋯
						</div>
					</div>
				</div>

				<div class="whatsAppGroup-body">
					@if (!g.Users.Any() && !g.ToAdd.Any())
					{
						<div class="empty-group">No users yet.</div>
					}

					@foreach (var u in g.Users)
					{
						var isRemove = g.ToRemove.Any(r => NormalizePhone(r.PhoneNumber) == NormalizePhone(u.PhoneNumber));
						<div class="whatsAppGroup-grid @(isRemove ? "user-remove" : "user-row")" @onclick:stopPropagation>
							<div class="user-main">
								<span>@u.Name</span>
								@if (u.Name != u.PhoneNumber)
								{
									<span>(@u.PhoneNumber)</span>
								}
							</div>
							<div class="menu-ellipsis"
								 @onclick="e => ToggleUserMenu(e, u.Name)"
								 @onclick:stopPropagation>
								⋯
							</div>
						</div>
					}

					@foreach (var u in g.ToAdd)
					{
						<div class="whatsAppGroup-grid user-add-preview">
							<div class="user-main">@u.Name <span class="user-status user-status-add">(Will be added)</span></div>
							<div class="user-details"><strong>Phone:</strong> @u.PhoneNumber</div>
						</div>
					}
				</div>
			</div>
		}
	</div>

	@if (_contextMenuVisible)
	{
		<div class="context-menu" style="@($"top:{_contextMenuY}; left:{_contextMenuX};")">
			<div class="context-item" @onclick="() => ShowAddUserModal(_contextGroupName)">➕ Add User</div>
			<div class="context-item" @onclick="() => BeginRenameGroup(_contextGroupName)">🖊️ Rename Group</div>
			<div class="context-item" @onclick="() => ConfirmDeleteGroup(_contextGroupName)">🗑️ Delete Group</div>
		</div>
	}

	@if (_contextUserMenuVisible)
	{
		<div class="context-menu" style="@($"top:{_contextUserMenuY}; left:{_contextUserMenuX};")">
			<div class="context-item" @onclick="() => ConfirmDeleteUser(_contextUserName)">🗑️ Delete User</div>
		</div>
	}
}

<GenericModal Visible="@_modalVisible"
			  VisibleChanged="@((bool v) => _modalVisible = v)"
			  Title="@_modalTitle"
			  BodyText="@_modalBodyText"
			  Fields="@_modalFields"
			  Buttons="@_modalButtons" />
