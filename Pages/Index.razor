@page "/"
@using WhatsAppAdmin.Models
@inject IJSRuntime JS
@attribute [Authorize]
<PageTitle>Index</PageTitle>

@inject WhatsAppAdmin.Services.IService Service
<div class="whatsAppGroups-board">
    @foreach (var whatsAppGroup in _whatsAppGroups)
    {
        <div class="whatsAppGroup-column"
             ondragover="event.preventDefault()"
             @ondrop="e => OnDrop(e, whatsAppGroup.Id)"
             @ondragover:preventDefault>

            <div class="whatsAppGroup-header" data-color="@GetWhatsAppGroupColor(whatsAppGroup.Name)">
                @whatsAppGroup.Name
            </div>

            <div class="whatsAppGroup-body">
                <div class="whatsAppGroup-grid whatsAppGroup-grid-header">
                    <div>User</div>
                    <div>For</div>
                </div>

                @foreach (var user in whatsAppGroup.Users)
                {
                    <div class="whatsAppGroup-grid user-row"
                         draggable="true"
                         @ondragstart="e => OnDragStart(e, user.Id, whatsAppGroup.Id)">
                        <div>@user.Name</div>
                        <div>@user.Rating</div>
                    </div>
                }
            </div>
        </div>
    }
</div>



<script>
	window.dragHelper = {
		setDragData: function (e, data) {
			e.dataTransfer.setData("text/plain", data);
		}
	};
</script>

@code {
    private List<WhatsAppGroup> _whatsAppGroups = new();
    private bool _loading = true;

    // temp drag info
    private Guid _draggingUserId;
    private string? _dragFromWhatsAppGroupId;

    protected override async Task OnInitializedAsync()
    {
        _whatsAppGroups = await Service.GetWhatsAppGroupsAsync();
        _loading = false;
    }

    private void OnDragStart(DragEventArgs e, Guid userId, string fromWhatsAppGroupId)
    {
        // store the drag info server-side (no call to DataTransfer.SetData)
        _draggingUserId = userId;
        _dragFromWhatsAppGroupId = fromWhatsAppGroupId;

        // optionally set the allowed effect, this doesn't call setData:
        if (e.DataTransfer != null)
        {
            e.DataTransfer.DropEffect = "move";
        }
        // No DataTransfer.SetData call here — that caused the exception.
    }

    private async Task OnDrop(DragEventArgs e, string toWhatsAppGroupId)
    {
        if (_draggingUserId == Guid.Empty || string.IsNullOrEmpty(_dragFromWhatsAppGroupId)) return;
        if (_dragFromWhatsAppGroupId == toWhatsAppGroupId) return; // no-op

        _loading = true;
        StateHasChanged();

        // call service to move
        _whatsAppGroups = await Service.MoveUserAsync(_draggingUserId, _dragFromWhatsAppGroupId, toWhatsAppGroupId);

        // reset
        _draggingUserId = Guid.Empty;
        _dragFromWhatsAppGroupId = null;
        _loading = false;
        StateHasChanged();
    }

    private string GetWhatsAppGroupColor(string name) => name switch
    {
        var n when n.Contains("1") => "blue",
        var n when n.Contains("2") => "red",
        var n when n.Contains("3") => "purple",
        _ => "orange"
    };
}

