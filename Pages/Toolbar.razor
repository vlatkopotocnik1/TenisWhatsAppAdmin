@using System.Globalization
@using CsvHelper
@using CsvHelper.Configuration
@using MudBlazor
@using WhatsAppAdmin.Models
@inject WhatsAppAdmin.Services.ImportStateService ImportState
@inject WhatsAppAdmin.Services.IService Service
@inject ISnackbar Snackbar

<MudStack Row="true" Spacing="2" Class="mb-3">

    <!-- Import from CSV -->
    <MudButton Variant="Variant.Filled" Color="Color.Success" HtmlTag="label" For="csvFileInput">
        <MudIcon Icon="@Icons.Material.Filled.UploadFile" Class="mr-2" />
        Import from CSV file
    </MudButton>

    <InputFile id="csvFileInput" OnChange="OnCsvSelected" Style="display:none" />

    <!-- Import from Service -->
    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ImportFromService">
        <MudIcon Icon="@Icons.Material.Filled.Sync" Class="mr-2" />
        Import from Service
    </MudButton>

</MudStack>

@code {

    // CSV parsing config - semicolon separated like your sample
    private readonly CsvConfiguration _csvConfig = new(CultureInfo.InvariantCulture)
    {
        Delimiter = ";",
        HasHeaderRecord = false,
        IgnoreBlankLines = true,
        TrimOptions = TrimOptions.Trim,
        BadDataFound = null
    };

    private async Task OnCsvSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        StateHasChanged();
        var groups = new List<WhatsAppGroup>();
        try
        {
            // Read file into memory (for small/medium files). Increase limit if needed.
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024).CopyToAsync(ms);
            ms.Position = 0;
            using var sr = new StreamReader(ms);
            var csvText = await sr.ReadToEndAsync();

            // Parse into groups
            groups = ParseCsvToGroups(csvText);

            // store into import state (in-memory)
            ImportState.SetGroups(groups);

        }
        catch (Exception ex)
        {
            Snackbar.Add($"CSV import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            StateHasChanged();
            Snackbar.Add($"Imported {groups.Sum(g => g.Users.Count)} rows into {groups.Count} groups.", Severity.Success);
        }
    }

    private async Task ImportFromService()
    {

        StateHasChanged();

        try
        {
            List<WhatsAppGroup> serviceGroups;
            try
            {
                serviceGroups = (await Service.GetWhatsAppGroupsAsync()) ?? new List<WhatsAppGroup>();
            }
            catch
            {
                serviceGroups = new List<WhatsAppGroup>();
            }

            // Convert service domain model into Import DTOs expected by ImportStateService
            var imported = serviceGroups.Select(g => new WhatsAppGroup
            {
                Id = g.Id ?? Guid.NewGuid().ToString(),
                Name = g.Name ?? string.Empty,
                Users = g.Users?.Select(u => new User
                {
                    Id = u.Id,
                    Name = u.Name,
                    PhoneNumber = u.PhoneNumber ?? string.Empty   // store phone in Rating field of DTO (or adjust DTO)
                }).ToList() ?? new List<User>()
            }).ToList();

            // Push into ImportStateService so Index page will pick it up
            ImportState.SetGroups(imported);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Service import failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            Snackbar.Add("Imported from service", Severity.Success);
            StateHasChanged();
        }
    }


    private List<WhatsAppGroup> ParseCsvToGroups(string csvText)
    {
        var groups = new List<WhatsAppGroup>();
        using var reader = new StringReader(csvText);
        using var csv = new CsvReader(reader, _csvConfig);

        while (csv.Read())
        {
            var record = csv.Parser.Record;
            if (record == null || record.Length == 0) continue;

            // columns: GroupName ; PlayerName ; PhoneNumber
            var groupName = record.Length >= 1 ? (record[0] ?? "").Trim() : "";
            var userName = record.Length >= 2 ? (record[1] ?? "").Trim() : "";
            var phoneRaw = record.Length >= 3 ? (record[2] ?? "").Trim() : "";

            if (string.IsNullOrWhiteSpace(groupName) && string.IsNullOrWhiteSpace(userName)) continue;

            // normalize phone minimally
            string phone = NormalizePhone(phoneRaw);

            var group = groups.FirstOrDefault(g => string.Equals(g.Name, groupName, StringComparison.OrdinalIgnoreCase));
            if (group == null)
            {
                group = new WhatsAppGroup { Name = groupName };
                groups.Add(group);
            }

            group.Users.Add(new User
            {
                Name = userName,
                PhoneNumber = phone
            });
        }

        return groups;
    }

    public string NormalizePhone(string phoneNumber)
    {
        return phoneNumber.Replace("+", "").Replace("@c.us", "").Trim();
    }
}
